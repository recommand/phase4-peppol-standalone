SECRETS=$(kamal secrets fetch --adapter 1password --account brbxbv.1password.eu --from "Deploy Secrets/Recommand Peppol - AP Experimental" KAMAL_REGISTRY_PASSWORD PEPPOL_SEATID PEPPOL_REPORTING_SENDERID PHASE4_API_REQUIREDTOKEN RECOMMAND_API_INTERNAL_TOKEN ORG_APACHE_WSS4J_CRYPTO_MERLIN_KEYSTORE_PASSWORD)

KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD $SECRETS)

# Phase4 Peppol Standalone secrets
PEPPOL_SEATID=$(kamal secrets extract PEPPOL_SEATID $SECRETS)
PEPPOL_REPORTING_SENDERID=$(kamal secrets extract PEPPOL_REPORTING_SENDERID $SECRETS)
PHASE4_API_REQUIREDTOKEN=$(kamal secrets extract PHASE4_API_REQUIREDTOKEN $SECRETS)
RECOMMAND_API_INTERNAL_TOKEN=$(kamal secrets extract RECOMMAND_API_INTERNAL_TOKEN $SECRETS)
ORG_APACHE_WSS4J_CRYPTO_MERLIN_KEYSTORE_PASSWORD=$(kamal secrets extract ORG_APACHE_WSS4J_CRYPTO_MERLIN_KEYSTORE_PASSWORD $SECRETS)